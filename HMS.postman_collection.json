            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/organizations/{{organizationUid}}/properties",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "organizations", "{{organizationUid}}", "properties"]
            },
            "description": "Requires PLATFORM_ADMIN. propertyType 0 = Hotel."
          },
          "event": [
            {
              "listen": "test",
              "script": {
