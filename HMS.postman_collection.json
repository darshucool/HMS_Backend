            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"ABC\",\n  \"name\": \"ABC Hotels\",\n  \"legalName\": \"ABC Hotels Pvt Ltd\",\n  \"defaultCurrency\": \"LKR\",\n  \"timezone\": \"Asia/Colombo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/platform/organizations",
