            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ABC Hotel Colombo Updated\",\n  \"propertyType\": 0,\n  \"description\": \"City hotel\",\n  \"addressLine1\": \"123 Galle Road\",\n  \"addressLine2\": null,\n  \"city\": \"Colombo\",\n  \"district\": \"Colombo\",\n  \"province\": \"Western\",\n  \"postalCode\": \"00300\",\n  \"countryCode\": \"LK\",\n  \"latitude\": null,\n  \"longitude\": null,\n  \"phone\": \"+94112223344\",\n  \"email\": \"info@abchotel.com\",\n  \"timezone\": \"Asia/Colombo\",\n  \"defaultCurrency\": \"LKR\",\n  \"status\": 1\n}"
            },
