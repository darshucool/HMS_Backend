              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "properties", "{{propertyUid}}"]
            }
          }
        },
        {
          "name": "Update Property",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
