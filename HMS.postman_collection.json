{
  "info": {
    "_postman_id": "7c2b8d9a-5e21-4b6e-9d34-hotel-management-api",
    "name": "HMS Backend API",
    "description": "Postman collection for implemented HMS Backend APIs only.\n\nBase URL: http://localhost:5094\n\nAuth: most routes need a Bearer token from Staff Login. Create organization/property require a PLATFORM_ADMIN token.\n\nEnums are sent as numbers (ASP.NET default):\n- PropertyType: Hotel=0, Guesthouse=1, Villa=2, Apartment=3, Hostel=4, Homestay=5, Resort=6, Campsite=7, Lodge=8, Bungalow=9, Other=10\n- PropertyStatus: Draft=0, Active=1, Suspended=2, Closed=3\n- UnitKind: Room=0, Villa=1, Apartment=2, Cabin=3, Tent=4, DormBed=5, Cottage=6, EntireProperty=7, Other=8\n- AccommodationUnitStatus: Available=0, Occupied=1, OutOfService=2, Maintenance=3, Inactive=4\n- HousekeepingStatus: Clean=0, Dirty=1, Inspected=2, InProgress=3, NotApplicable=4\n- UnitBlockType: Maintenance=0, OwnerUse=1, Closed=2, Other=3\n- PricingBasis: PerRoomPerNight=0, PerPersonPerNight=1, PerBedPerNight=2, FlatPerStay=3\n- GuestType: Individual=0, Couple=1, Family=2, Group=3, Corporate=4, TravelAgent=5\n- DocumentType: Nic=0, Passport=1, DrivingLicence=2, Other=3\n- PreferenceType: Room=0, Dietary=1, Accessibility=2, Communication=3, Other=4\n- dayOfWeek: Sunday=0 through Saturday=6, or null for all days",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5094",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "organizationUid",
      "value": "",
      "type": "string"
    },
    {
      "key": "propertyUid",
      "value": "",
      "type": "string"
    },
    {
      "key": "staffUid",
      "value": "",
      "type": "string"
    },
    {
      "key": "accommodationTypeUid",
      "value": "",
      "type": "string"
    },
    {
      "key": "unitUid",
      "value": "",
      "type": "string"
    },
    {
      "key": "unitBlockUid",
      "value": "",
      "type": "string"
    },
    {
      "key": "mealPlanUid",
      "value": "",
      "type": "string"
    },
    {
      "key": "ratePlanUid",
      "value": "",
      "type": "string"
    },
    {
      "key": "ratePlanPriceUid",
      "value": "",
      "type": "string"
    },
    {
      "key": "guestUid",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Identity",
      "item": [
        {
          "name": "Super Admin Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@hms.local\",\n  \"password\": \"SuperAdmin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/auth/super-admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "auth", "super-admin", "login"]
            },
            "description": "Dummy platform super admin. Email: superadmin@hms.local / Password: SuperAdmin@123. Returns PLATFORM_ADMIN JWT. No database user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "    pm.collectionVariables.set('token', json.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Invite Property Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyUid\": \"{{propertyUid}}\",\n  \"email\": \"admin@abchotels.com\",\n  \"firstName\": \"Hotel\",\n  \"lastName\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/auth/admin/invite",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "auth", "admin", "invite"]
            },
            "description": "Requires PLATFORM_ADMIN. Creates or reuses the admin for this property (login is email + password). Emails the Admin Login URL, email, temporary password, and instructions to reset password after first login. Email cannot be changed later.\n\nIf SMTP fails, response includes emailSent=false and temporaryPassword."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.staffUid) {",
                  "    pm.collectionVariables.set('staffUid', json.staffUid);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyUid\": \"{{propertyUid}}\",\n  \"email\": \"admin@abchotels.com\",\n  \"password\": \"Admin@123\",\n  \"firstName\": \"Hotel\",\n  \"lastName\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/auth/admin/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "auth", "admin", "register"]
            },
            "description": "Requires PLATFORM_ADMIN token. Creates HOTEL_ADMIN for the property. Login uses email + password (no username)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.staffUid) {",
                  "    pm.collectionVariables.set('staffUid', json.staffUid);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@abchotels.com\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/auth/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "auth", "admin", "login"]
            },
            "description": "Hotel admin / manager login with email + password. propertyUid is optional. Response includes propertyUids. After first invite login, call Reset Admin Password."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "    pm.collectionVariables.set('token', json.accessToken);",
                  "}",
                  "if (json.propertyUid && json.propertyUid !== '00000000-0000-0000-0000-000000000000') {",
                  "    pm.collectionVariables.set('propertyUid', json.propertyUid);",
                  "}",
                  "if (json.propertyUids && json.propertyUids.length) {",
                  "    pm.collectionVariables.set('propertyUid', json.propertyUids[0]);",
                  "}",
                  "if (json.staffUid) {",
                  "    pm.collectionVariables.set('staffUid', json.staffUid);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Reset Admin Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/auth/admin/credentials",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "auth", "admin", "credentials"]
            },
            "description": "Requires HOTEL_ADMIN / MANAGER token. Resets password only. Email cannot be changed. staffUid stays the same."
          }
        },
        {
          "name": "Register Staff",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyUid\": \"{{propertyUid}}\",\n  \"email\": \"desk@abchotels.com\",\n  \"password\": \"Staff@123\",\n  \"firstName\": \"Front\",\n  \"lastName\": \"Desk\",\n  \"role\": \"FRONT_DESK\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/auth/staff/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "auth", "staff", "register"]
            },
            "description": "Requires PLATFORM_ADMIN or HOTEL_ADMIN token. Allowed roles: FRONT_DESK, HOUSEKEEPING, RESTAURANT, BAR, CASHIER."
          }
        },
        {
          "name": "Staff Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"desk@abchotels.com\",\n  \"password\": \"Staff@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hotel/auth/staff/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hotel", "auth", "staff", "login"]
            },
            "description": "Operational staff login with email + password. Also available at POST /api/hotel/auth/login. propertyUid is optional."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "    pm.collectionVariables.set('token', json.accessToken);",
                  "}",
                  "if (json.propertyUid && json.propertyUid !== '00000000-0000-0000-0000-000000000000') {",
                  "    pm.collectionVariables.set('propertyUid', json.propertyUid);",
                  "}",
                  "if (json.staffUid) {",
                  "    pm.collectionVariables.set('staffUid', json.staffUid);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Properties",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/me/properties",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "me", "properties"]
            },
            "description": "Lists properties the signed-in staff user can access."
          }
        }
      ]
    },
    {
      "name": "02 - Platform Organizations",
      "description": "Requires PLATFORM_ADMIN JWT.",
      "item": [
        {
          "name": "Create Organization",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
